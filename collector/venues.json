{
  "since_year": 1997,
  "_comment": "since_year: first publication year to collect; lowering it makes the next run backfill the missing years, raising it hides older papers from the site. queries: IEEE Xplore API search variants (first one that returns records is used); optional from/to limit the years a query is used (venue launch, ISSN changes). match: regex on the returned publication_title that assigns the venue. Order of 'venues' matters for matching.",
  "queries": [
    {"key": "JSSC",   "params": {"issn": "0018-9200"}, "fallback": {"publication_title": "IEEE Journal of Solid-State Circuits"}},
    {"key": "TCAS-I", "params": {"issn": "1549-8328"}, "fallback": {"publication_title": "Circuits and Systems I: Regular Papers"}, "from": 2004},
    {"key": "TCAS-II","params": {"issn": "1549-7747"}, "fallback": {"publication_title": "Circuits and Systems II: Express Briefs"}, "from": 2004},
    {"key": "TCAS-I-1992", "params": {"issn": "1057-7122"}, "fallback": {"publication_title": "Circuits and Systems I: Fundamental Theory and Applications"}, "to": 2003},
    {"key": "TCAS-II-1992","params": {"issn": "1057-7130"}, "fallback": {"publication_title": "Circuits and Systems II: Analog and Digital Signal Processing"}, "to": 2003},
    {"key": "TVLSI",  "params": {"issn": "1063-8210"}, "fallback": {"publication_title": "Very Large Scale Integration (VLSI) Systems"}},
    {"key": "SSC-L",  "params": {"issn": "2573-9603"}, "fallback": {"publication_title": "IEEE Solid-State Circuits Letters"}, "from": 2018},
    {"key": "ISSCC",  "params": {"publication_title": "International Solid-State Circuits Conference", "content_type": "Conferences"}},
    {"key": "A-SSCC", "params": {"publication_title": "Asian Solid-State Circuits Conference", "content_type": "Conferences"}, "from": 2005},
    {"key": "VLSI",   "params": {"publication_title": "Symposium on VLSI Technology and Circuits", "content_type": "Conferences"}, "from": 2022},
    {"key": "VLSI-C", "params": {"publication_title": "Symposium on VLSI Circuits", "content_type": "Conferences"}, "to": 2021},
    {"key": "CICC",   "params": {"publication_title": "Custom Integrated Circuits Conference", "content_type": "Conferences"}},
    {"key": "ESSCIRC","params": {"publication_title": "European Solid State Circuits Conference", "content_type": "Conferences"}, "to": 2023},
    {"key": "ESSERC", "params": {"publication_title": "European Solid-State Electronics Research Conference", "content_type": "Conferences"}, "from": 2024},
    {"key": "Access", "params": {"querytext": "(\"Publication Title\":\"IEEE Access\") AND (\"analog-to-digital\" OR \"digital-to-analog\" OR \"delta-sigma\" OR \"sigma-delta\" OR \"successive approximation\" OR \"noise-shaping\" OR \"time-interleaved\" OR ADC OR DAC)"},
     "from": 2013, "_comment": "launched 2013; ~20k papers/year, so only keyword hits are fetched. Do not combine issn with querytext: the API then ignores the issn."}
  ],
  "venues": [
    {"name": "SSC-L",   "match": "solid[- ]state circuits letters"},
    {"name": "JSSC",    "match": "journal of solid[- ]state circuits"},
    {"name": "TCAS-II", "match": "circuits and systems\\s*(ii|2)\\b|express briefs"},
    {"name": "TCAS-I",  "match": "circuits and systems\\s*(i|1)\\b|regular papers"},
    {"name": "TVLSI",   "match": "very large scale integration"},
    {"name": "A-SSCC",  "match": "asian solid[- ]state circuits|\\ba-sscc\\b"},
    {"name": "ESSCIRC", "match": "european solid[- ]state (circuits|device and circuits|electronics research)|\\besscirc\\b|\\besserc\\b"},
    {"name": "ISSCC",   "match": "international solid[- ]state circuits conference|\\bisscc\\b"},
    {"name": "VLSI",    "match": "symposium on vlsi"},
    {"name": "CICC",    "match": "custom integrated circuits conference|\\bcicc\\b"},
    {"name": "Access",  "match": "^ieee access$"}
  ]
}
